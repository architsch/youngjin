<%_ /* The same sentence as the RSS feed's channel description (see RssFeedBuilder). */ _%>
<%- include(`${ejsPartialRootPath}/common/header.ejs`, {
    title: "ThingsPool - " + PAGE_NAME_MAP["library"],
    desc: "A collection of essays and thought experiments, which cover a wide range of subjects including computer science, game design, logic, philosophy, and art.",
    url: `${URL_STATIC}/library.html`,
    pageName: "library",
    pagePathList: [
        {title: PAGE_NAME_MAP["index"], url: URL_STATIC},
        {title: PAGE_NAME_MAP["library"], url: undefined},
    ],
    backDestination_href: URL_STATIC,
}) %>
<%_ for (const [category, entries] of Object.entries(entriesByCategory)) { _%>
<hr>
<h1><%= category %></h1>
<%_ for (let i = entries.length-1; i >= 0; --i) { _%>
<%_ const entry = entries[i]; _%>
<a class="postEntryButton" href="<%= URL_STATIC %>/<%= entry.dirName %>/list.html"><%= entry.title %></a>
<%_ } _%>
<%_ } _%>
<hr>
<%_ /* I ♥ RSS lists the RSS feed only while this page links back to it (see RssFeedBuilder). */ _%>
<p class="dim"><a class="dim" href="<%= URL_STATIC %>/feed.atom">Atom Feed</a>&nbsp;&nbsp;<a class="dim" href="<%= URL_STATIC %>/rss.xml">RSS Feed</a>&nbsp;&nbsp;<a class="dim" href="https://iheartrss.com/">I &hearts; RSS</a>&nbsp; <a class="dim" href="mailto:architsch@gmail.com">Write&nbsp;to&nbsp;the&nbsp;Author</a></p>
<%- include(`${ejsPartialRootPath}/common/footer.ejs`) %>