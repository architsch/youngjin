<%_ /* Carries the visitor's first `?ref=` of the session onto links into Robot Rooms, so arriving on a
      tagged post and then clicking Play still credits that source (see robot-rooms/docs/devOps/analytics.md). */ _%>
<script>
(function () {
    var ref = null;
    try { ref = sessionStorage.getItem("thingspool_ref"); } catch (e) {}
    if (!ref) {
        ref = new URLSearchParams(location.search).get("ref");
        try { if (ref) sessionStorage.setItem("thingspool_ref", ref); } catch (e) {}
    }
    if (!ref)
        return;
    var links = document.querySelectorAll('a[href^="<%= URL_ROBOT_ROOMS %>"]');
    for (var i = 0; i < links.length; ++i) {
        var url = new URL(links[i].href);
        if (!url.searchParams.has("ref")) {
            url.searchParams.set("ref", ref);
            links[i].href = url.toString();
        }
    }
})();
</script>
<%_ /* Shown over Robot Rooms, in the frame a link said in it opens (named so; see robot-rooms' WebPageFrameUtil), a page
      tells the game of a link into it, which closes the frame, and of one off the site, which the game offers to open
      in a new tab: a game can't see into a frame of another origin. */ _%>
<script>
(function () {
    if (window.parent === window || window.name !== "robotRoomsWebPage")
        return;
    var game = new URL("<%= URL_ROBOT_ROOMS %>").origin;
    var site = [location.origin, new URL("<%= URL_STATIC %>").origin];
    // A local server is both (see robot-rooms' EJSUtil.postProcessHTML): there, the game is what has no file extension.
    var shared = site.indexOf(game) >= 0;
    document.addEventListener("click", function (event) {
        var link = (event.target instanceof Element) ? event.target.closest("a[href]") : null;
        if (!link)
            return;
        var url = new URL(link.href, location.href);
        if (url.protocol !== "http:" && url.protocol !== "https:")
            return;
        if (url.origin === game && !(shared && /\.[a-z0-9]+$/i.test(url.pathname)))
            window.parent.postMessage({kind: "robotRooms:backToGame"}, "*");
        else if (site.indexOf(url.origin) < 0)
            window.parent.postMessage({kind: "robotRooms:outsideLink", href: url.href}, "*");
        else
            return;
        event.preventDefault();
    }, true);
})();
</script>
</body>
</html>