<div class="s_row"></div>
<%_ if (!locals.hidePortal) { _%>
<%- include(`${ejsPartialRootPath}/common/portal.ejs`) %>
<%_ } _%>
<p class="dim">&copy 2019-2026 ThingsPool. All rights reserved.<br><a class="dim" href="<%= URL_STATIC %>/privacy-policy.html">Privacy Policy</a>&nbsp;&nbsp;<a class="dim" href="<%= URL_STATIC %>/terms-of-service.html">Terms of Service</a></p>
<div class="xl_row"></div>
<%_ /* Carries the visitor's first `?ref=` of the session onto links into the app, so arriving on a
      tagged post and then clicking Play still credits that source (see docs/devOps/analytics.md). */ _%>
<script>
(function () {
    var ref = null;
    try { ref = sessionStorage.getItem("thingspool_ref"); } catch (e) {}
    if (!ref) {
        ref = new URLSearchParams(location.search).get("ref");
        try { if (ref) sessionStorage.setItem("thingspool_ref", ref); } catch (e) {}
    }
    if (!ref)
        return;
    var links = document.querySelectorAll('a[href^="<%= URL_DYNAMIC %>"]');
    for (var i = 0; i < links.length; ++i) {
        var url = new URL(links[i].href);
        if (!url.searchParams.has("ref")) {
            url.searchParams.set("ref", ref);
            links[i].href = url.toString();
        }
    }
})();
</script>
</body>
</html>