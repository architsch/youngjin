<%_ /* Held as written and escaped where they are output, rather than escaped once here. Escaping
      on the way in and then again on the way out is what put a literal `&quot;` in front of
      readers of the few post titles that contain a quotation mark. */ _%>
<%_ const v_title = locals.title ? locals.title : "ThingsPool"; _%>
<%_ const v_desc = locals.desc ? locals.desc : "ThingsPool is an experimental web community for collaborative research and development in arts, games, and other forms of interactive media."; _%>
<%_ const v_keywords = locals.keywords ? locals.keywords : "thingspool, software toys, technical design, computer science, systems engineering, game design, game development"; _%>
<%_ const v_ogImageAlt = locals.ogImageAlt ? locals.ogImageAlt : v_title; _%>
<%_ const v_url = locals.url ? locals.url : URL_STATIC _%>
<%_ const v_ogType = locals.ogType ? locals.ogType : "website" _%>
<%_ /* The address a page wants search engines to settle on, which is not always the one it was
      reached by — see the game page, whose rooms each share under their own address while
      pointing search back at the single entrance they all lead to. */ _%>
<%_ const v_canonicalURL = locals.canonicalURL ? locals.canonicalURL : v_url _%>
<%_ /* Set by the pages that are not addressed to the outside world at all — the error pages,
      which nobody shares on purpose and which have no business turning up in a search result. */ _%>
<%_ const v_ogDisabled = locals.ogDisabled ? true : false _%>
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="description" content="<%= v_desc %>">
<meta name="keywords" content="<%= v_keywords %>">
<meta name="author" content="Youngjin Kang">
<meta name="viewport" content="width=device-width, initial-scale=1">
<%_ /* Opts the page out of a mobile browser's automatic page-darkening, which would otherwise
      recolour the app's UI (see the `color-scheme` rule in the client's stylesheet). Declared
      here as well so it holds during the stretch before that stylesheet has loaded. */ _%>
<meta name="color-scheme" content="only light">
<%_ if (v_ogDisabled) { _%>
<meta name="robots" content="noindex">
<%_ } _%>
<!-- PROD_CODE_BEGIN -->
<%_ if (!v_ogDisabled) { _%>
<%- include(`${ejsPartialRootPath}/common/ogTags.ejs`, {
    ogTitle: v_title,
    ogDesc: v_desc,
    ogURL: v_url,
    ogType: v_ogType,
    ogImageURL: locals.ogImageURL,
    ogImageWidth: locals.ogImageWidth,
    ogImageHeight: locals.ogImageHeight,
    ogImageAlt: v_ogImageAlt,
}) -%>
<link rel="canonical" href="<%= v_canonicalURL %>">
<%_ } _%>
<%- include(`${ejsPartialRootPath}/common/googleAnalytics.ejs`) -%>
<!-- PROD_CODE_END -->
<title><%= v_title %></title>
<link rel="shortcut icon" href="<%= URL_STATIC %>/favicon.ico">
<%_ if (locals.useTailwindCSS) { _%>
<link rel="stylesheet" href="<%= URL_DYNAMIC %>/app/style.css">
<%_ } else { _%>
<link rel="stylesheet" href="<%= URL_STATIC %>/style.css">
<%_ } _%>
<link rel="author" href="https://www.linkedin.com/in/youngjin-kang-55321882">
</head>
<body style="background-color: black;">
<%_ if (includeFullscreenPanel) { _%>
<div class="fullscreenPanel" style="top: 0; bottom: 0; left: 0; right: 0; width: 95%; height: 100%;">
<%_ } _%>