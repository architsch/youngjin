<%_ /* Share-preview metadata: what a social network, chat client or messenger shows when one of
      this site's addresses is posted into it. Included by the header partials on behalf of any
      page that has not opted out of it (see their `ogDisabled` parameter).

      Text arrives exactly as its page wrote it and is escaped here, on the way out. */ _%>
<%_ /* Presented by any page that does not name a share image of its own. */ _%>
<%_ const DEFAULT_OG_IMAGE = { path: "/share.jpg", width: 1200, height: 630 }; _%>
<%_ /* Width-to-height ratio from which on an image is wide enough to fill the banner card. */ _%>
<%_ const WIDE_OG_IMAGE_MIN_ASPECT_RATIO = 1.5; _%>
<%_ const v_ogImageURL = locals.ogImageURL ? locals.ogImageURL : `${URL_STATIC}${DEFAULT_OG_IMAGE.path}`; _%>
<%_ /* A page that names a share image of its own is the only one in a position to say how large
      it is, so when it does not, the dimensions go undeclared rather than guessed. That matters
      because the preview services size their crop box from these two numbers before the image
      itself arrives: a wrong pair distorts the card far more visibly than a missing pair, which
      merely costs the service the round trip it takes to measure the image for itself. */ _%>
<%_ const v_ogImageWidth = locals.ogImageURL ? locals.ogImageWidth : DEFAULT_OG_IMAGE.width; _%>
<%_ const v_ogImageHeight = locals.ogImageURL ? locals.ogImageHeight : DEFAULT_OG_IMAGE.height; _%>
<%_ const v_ogImageSizeKnown = v_ogImageWidth > 0 && v_ogImageHeight > 0; _%>
<%_ /* The card style follows from those same measurements: only a wide image can fill the banner
      format without being cropped past the point of being recognisable, so anything closer to
      square — or taller than it is wide — is given the compact format instead. With nothing to
      judge by, the choice is left to the service rather than guessed at. */ _%>
<%_ const v_twitterCard = v_ogImageSizeKnown
        ? ((v_ogImageWidth / v_ogImageHeight >= WIDE_OG_IMAGE_MIN_ASPECT_RATIO) ? "summary_large_image" : "summary")
        : undefined; _%>
<meta property="og:title" content="<%= ogTitle %>"/>
<meta property="og:url" content="<%= ogURL %>"/>
<meta property="og:type" content="<%= ogType %>"/>
<meta property="og:site_name" content="ThingsPool"/>
<meta property="og:description" content="<%= ogDesc %>"/>
<meta property="og:image" content="<%= v_ogImageURL %>"/>
<meta property="og:image:alt" content="<%= ogImageAlt %>">
<%_ if (v_ogImageSizeKnown) { _%>
<meta property="og:image:width" content="<%= v_ogImageWidth %>"/>
<meta property="og:image:height" content="<%= v_ogImageHeight %>"/>
<meta name="twitter:card" content="<%= v_twitterCard %>">
<%_ } _%>
