<%_ /* Held as written and escaped where they are output, rather than escaped once here. Escaping
      on the way in and then again on the way out is what put a literal `&quot;` in front of
      readers of the few post titles that contain a quotation mark. */ _%>
<%_ const v_title = locals.title ? locals.title : "ThingsPool"; _%>
<%_ const v_desc = locals.desc ? locals.desc : "ThingsPool is an experimental web community for collaborative research and development in arts, games, and other forms of interactive media."; _%>
<%_ const v_keywords = locals.keywords ? locals.keywords : "thingspool, software toys, technical design, computer science, systems engineering, game design, game development"; _%>
<%_ const v_ogImageAlt = locals.ogImageAlt ? locals.ogImageAlt : v_title; _%>
<%_ const v_url = locals.url ? locals.url : URL_STATIC _%>
<%_ const v_ogType = locals.ogType ? locals.ogType : "website" _%>
<%_ /* The address a page wants search engines to settle on, which is not always the one it was
      reached by. */ _%>
<%_ const v_canonicalURL = locals.canonicalURL ? locals.canonicalURL : v_url _%>
<%_ /* Set by the pages that are not addressed to the outside world at all. */ _%>
<%_ const v_ogDisabled = locals.ogDisabled ? true : false _%>
<%_ const v_pagePathList = locals.pagePathList ? locals.pagePathList : undefined; _%>
<%_ const v_backDestination_href = locals.backDestination_href ? locals.backDestination_href : undefined; _%>
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="description" content="<%= v_desc %>">
<meta name="keywords" content="<%= v_keywords %>">
<meta name="author" content="Youngjin Kang">
<meta name="viewport" content="width=device-width, initial-scale=1">
<%_ /* Opts the page out of a mobile browser's automatic page-darkening, which would otherwise
      recolour a design that is already dark (see the `color-scheme` rule in the stylesheet). */ _%>
<meta name="color-scheme" content="only light">
<%_ if (v_ogDisabled) { _%>
<meta name="robots" content="noindex">
<%_ } _%>
<!-- PROD_CODE_BEGIN -->
<%_ if (!v_ogDisabled) { _%>
<%- include(`${ejsPartialRootPath}/common/ogTags.ejs`, {
    ogTitle: v_title,
    ogDesc: v_desc,
    ogURL: v_url,
    ogType: v_ogType,
    ogImageURL: locals.ogImageURL,
    ogImageWidth: locals.ogImageWidth,
    ogImageHeight: locals.ogImageHeight,
    ogImageAlt: v_ogImageAlt,
}) -%>
<link rel="canonical" href="<%= v_canonicalURL %>">
<%_ } _%>
<%- include(`${ejsPartialRootPath}/common/googleAnalytics.ejs`) -%>
<!-- PROD_CODE_END -->
<title><%= v_title %></title>
<link rel="shortcut icon" href="<%= URL_STATIC %>/favicon.ico">
<link rel="stylesheet" href="<%= URL_STATIC %>/style.css">
<link rel="author" href="https://www.linkedin.com/in/youngjin-kang-55321882">
<link rel="alternate" type="application/atom+xml" href="<%= URL_STATIC %>/feed.atom" title="Atom Feed">
</head>
<body>
<div class="fullscreenBar">
<div class="fullscreenBarLogo">
<img class="fullscreenBarLogoImage" src="<%= URL_STATIC %>/logo_light.png" alt="ThingsPool Logo">
</div>
<div class="fullscreenBarMenu">
<a class="fullscreenBarMenuButton <%= (pageName == "index") ? "selected" : "idle" %>" href="<%= URL_STATIC %>"><%= PAGE_NAME_MAP["index"] %></a>
<a class="fullscreenBarMenuButton <%= (pageName == "library") ? "selected" : "idle" %>" href="<%= URL_STATIC %>/library.html"><%= PAGE_NAME_MAP["library"] %></a>
</div>
</div>
<div class="fullscreenPanel">
<div class="s_row"></div>
<%_ if (v_backDestination_href != undefined) { _%>
<a class="inlineButton" href="<%= v_backDestination_href %>">Back</a><%- (v_pagePathList != undefined) ? "&nbsp;&nbsp;" : "" %>
<%_ } _%>
<%_ if (v_pagePathList != undefined) { _%>
<%_ /* Assembles its own links, so it has to be written out raw — which makes escaping each value
      on the way in this trail's own responsibility. `escapeFn` is the very function an escaping
      output tag runs, so a title reads the same here as it does everywhere else on the page. */ _%>
<div class="pagePath"><%- v_pagePathList.map(x => (x.url != undefined) ? `<a href="${escapeFn(x.url)}">${escapeFn(x.title)}</a>` : escapeFn(x.title)).join("/") %></div>
<%_ } _%>
<%_ if (v_pagePathList != undefined || v_backDestination_href != undefined) { _%>
<div class="s_row"></div>
<%_ } _%>