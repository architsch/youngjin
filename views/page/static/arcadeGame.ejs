<%- include(`${ejsPartialRootPath}/common/header.ejs`, {
    title: "ThingsPool - " + entry.title,
    desc: description,
    keywords: keywords,
    url: `${URL_STATIC}/${relativeURL}`,
    pageName: "arcade",
    pagePathList: [
        {title: PAGE_NAME_MAP["index"], url: URL_STATIC},
        {title: PAGE_NAME_MAP["arcade"], url: `${URL_STATIC}/arcade.html`},
        {title: entry.title, url: undefined},
    ],
    backDestination_href: `${URL_STATIC}/arcade.html`,
}) %>
<h1><%= entry.title %></h1>
<%_ /* A store's own badge (playLinkImagePathOverride) is shown as the store made it, without the Play button's glow. */ _%>
<%_ if (entry.playLinkImagePathOverride == undefined) { _%>
<a class="noTextDeco imageButton" target="_blank" href="<%= entry.playLinkURL %>" ontouchstart="">
<%_ } else { _%>
<a class="noTextDeco" target="_blank" href="<%= entry.playLinkURL %>">
<%_ } _%>
<img class="s_image" src="<%= URL_STATIC %>/<%= playLinkImagePath %>" alt="Play">
</a>
<div class="zero_row"></div>
<%- content %>
<%- include(`${ejsPartialRootPath}/common/footer.ejs`) %>