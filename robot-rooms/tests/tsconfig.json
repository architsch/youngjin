{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "allowJs": true,
        "noImplicitAny": true,
        "module": "esnext",
        "target": "es2020",
        "jsx": "react-jsx",
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "types": ["vitest/globals"],
        "lib": ["dom", "dom.iterable", "dom.asynciterable", "ES2022"]
    },
    "include": ["./**/*", "../src/server/**/*", "../src/shared/**/*", "../src/client/**/*.d.ts"],
    "exclude": ["./e2e"]
}
