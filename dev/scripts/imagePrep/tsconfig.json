{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "noImplicitAny": true,
        "module": "es2020",
        "target": "es2020",
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "lib": ["es2022"],
        "types": ["node"]
    },
    "include": ["core/**/*", "node/**/*"]
}
